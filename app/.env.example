# Copy thành app/.env để chạy web trên laptop (.env đã nằm trong .gitignore).
# Trên EC2 các biến này do user data ghi vào, không dùng file này.
AWS_REGION=ap-southeast-2
ORIGINALS_BUCKET=
PROCESSED_BUCKET=
# Để trống nếu chưa có CloudFront: web sẽ dùng presigned GET
CDN_DOMAIN=
# Laptop: Postgres cục bộ, ví dụ docker run -p 5432:5432 -e POSTGRES_PASSWORD=dev postgres:16
DATABASE_URL=postgresql://postgres:dev@localhost:5432/postgres
# Trên AWS thay DATABASE_URL bằng 2 biến này (mật khẩu lấy từ Secrets Manager):
# DB_HOST=
# DB_SECRET_ARN=
# Chỉ cần khi chạy laptop mà không có DB; trên AWS khoá ký cookie tự suy ra từ mật khẩu DB
# SECRET_KEY=dev-only
# Chỉ worker cần (URL queue jobs, output của Phong)
# QUEUE_URL=
